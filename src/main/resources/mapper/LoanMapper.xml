<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="edu.secure.lab.mapper.LoanMapper">

    <!-- [취약] ${customerId} 는 값이 SQL 문자열에 그대로 이어 붙는다 -->
    <select id="findByCustomerVuln" resultType="edu.secure.lab.domain.Loan">
        SELECT loan_id, customer_id, balance, status
          FROM loan
         WHERE customer_id = '${customerId}'
    </select>

    <!-- [안전] #{customerId} 는 PreparedStatement 바인딩 -->
    <select id="findByCustomerSafe" resultType="edu.secure.lab.domain.Loan">
        SELECT loan_id, customer_id, balance, status
          FROM loan
         WHERE customer_id = #{customerId}
    </select>

    <!-- =========================================================================
         [실습 문제 1] 잔액 하한 조건을 추가한 안전한 조회 쿼리 만들기 (1/2)
         =========================================================================
         목표: 위 'findByCustomerSafe' 쿼리를 참고하여, 특정 고객(customerId)의 대출 중
               잔액(balance)이 최소잔액(minBalance) 이상인 데이터만 조회하는 쿼리를 작성하세요.

         작성 순서(힌트):
         1. 아래 주석 처리된 <select> 태그의 주석을 해제하세요.
         2. WHERE 절에 고객 ID 조건과 잔액 하한 조건을 모두 작성하세요.
         3. 주의! 취약한 '${}'가 아니라 반드시 안전한 바인딩 기호인 '#{}'를 사용해야 합니다.
            - 고객 ID 파라미터 이름: #{customerId}
            - 최소 잔액 파라미터 이름: #{minBalance}
            - SQL 조건식 예시: WHERE customer_id = ... AND balance >= ...
         4. 이 파일 작성이 끝나면 LoanMapper.java 파일로 이동해 (2/2) 단계도 완성하세요.
    ========================================================================== -->
    
    <select id="findByCustomerMin" resultType="edu.secure.lab.domain.Loan">
        SELECT loan_id, customer_id, balance, status
          FROM loan
         WHERE customer_id = #{customerId}
         	AND balance >= #{minBalance}"
         
    </select>
   

    <!-- ORDER BY 컬럼명은 바인딩 불가. Service 에서 허용 목록으로 검증한 값만 전달해야 한다 -->
    <select id="findByCustomerSorted" resultType="edu.secure.lab.domain.Loan">
        SELECT loan_id, customer_id, balance, status
          FROM loan
         WHERE customer_id = #{customerId}
         ORDER BY ${sortBy}
    </select>

    <select id="findById" resultType="edu.secure.lab.domain.Loan">
        SELECT loan_id, customer_id, balance, status
          FROM loan
         WHERE loan_id = #{loanId}
    </select>

    <select id="findByIdAndCustomer" resultType="edu.secure.lab.domain.Loan">
        SELECT loan_id, customer_id, balance, status
          FROM loan
         WHERE loan_id = #{loanId}
           AND customer_id = #{customerId}
    </select>

    <select id="selectBalance" resultType="java.lang.Long">
        SELECT balance FROM loan WHERE loan_id = #{loanId}
    </select>

    <update id="updateBalance">
        UPDATE loan SET balance = #{balance} WHERE loan_id = #{loanId}
    </update>

    <!-- 소유자 확인 + 잔액 충분 확인 + 차감을 한 문장에서 처리 -->
    <update id="repayConditional">
        UPDATE loan
           SET balance = balance - #{amount}
         WHERE loan_id = #{loanId}
           AND customer_id = #{customerId}
           AND balance >= #{amount}
    </update>
</mapper>
